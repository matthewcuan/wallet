# Server
PORT=3000
HOST=0.0.0.0

# Pick which signer the server uses at boot:
#   mock     — default. Returns a JSON envelope; useful for local UI dev.
#              The iOS Wallet sheet will fail at PKPass(data:), as expected.
#   passslot — Uses passslot.com (no Apple Developer Program required).
#              Requires PASSSLOT_APP_KEY and PASSSLOT_TEMPLATE_ID below.
#   passkit  — Uses your own Apple Pass Type ID cert via passkit-generator.
#              Requires the certificate paths and identifiers below.
SIGNER=mock

# --- passslot signer ---
# Get an App Key at https://www.passslot.com/ (free tier: 1k passes, 1 Pass Type ID).
# Create a template and add placeholders named: label, description, passType,
# barcodeMessage, barcodeAltText. Wire barcodeMessage into the template's barcode.
PASSSLOT_APP_KEY=
PASSSLOT_TEMPLATE_ID=
# Override only if you're targeting a non-default endpoint:
# PASSSLOT_BASE_URL=https://api.passslot.com/v1

# --- passkit signer (Apple-issued cert) ---
# Pass identifiers (from Apple Developer portal; required for SIGNER=passkit)
PASS_TYPE_IDENTIFIER=pass.com.example.wallet
TEAM_IDENTIFIER=
ORGANIZATION_NAME=Wallet

# Certificates (PEM format; required for SIGNER=passkit).
# To produce these from a .p12 exported from the Apple Developer portal:
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -out signerCert.pem
#   openssl pkcs12 -in pass.p12 -nocerts        -out signerKey.pem
# Place the WWDR intermediate cert (downloaded from Apple) at WWDR_CERT_PATH.
SIGNER_CERT_PATH=./certs/signerCert.pem
SIGNER_KEY_PATH=./certs/signerKey.pem
SIGNER_KEY_PASSPHRASE=
WWDR_CERT_PATH=./certs/wwdr.pem

# Pass templates directory for SIGNER=passkit. Must contain one subdirectory
# per pass type (storeCard, generic, coupon, eventTicket, boardingPass) with
# pass.json, icon.png/@2x/@3x, logo.png/@2x/@3x.
TEMPLATES_PATH=./templates
